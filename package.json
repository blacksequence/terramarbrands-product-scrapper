{
    "name": "terramarbrands-product-scrapper",
    "version": "1.1.0",
    "type": "module",
    "description": "Scrapes the full product catalog from terramarbrands.com.mx via public WCF API.",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@crawlee/cheerio": "^3.18.2",
        "apify": "^3.7.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^26.6.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint src/",
        "lint:fix": "eslint --fix src/",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "validate": "node scripts/pre-push-check.js",
        "predeploy": "npm run validate && npm test && npm run lint"
    },
    "author": "It's not you it's me",
    "license": "ISC"
}
